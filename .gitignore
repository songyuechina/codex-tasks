# Source code, docs, and meta files belong in the repo.
# Large CAD assets, generated process artifacts, and exported PDFs do not.

# Python cache
__pycache__/
*.py[cod]

# CAD/runtime artifacts
*.log
*.lock
*.bak
*.bak_*
*.dwl
*.dwl2
*.dwg
*.pdf

# Generated CAD cases / print process outputs
cad/scripts/drawing_basic_service/print/cases/assets/
cad/scripts/drawing_basic_service/print/cases/output/
dwg_agents_ops/agent_control/supervision/
cad/tools/_dump/*.jsonl
cad/system/logs/

# Local tool/cache data
.accelerate/
CAD_AUDIT.sqlite
dwg_agents_ops/local/

# Agent runtime/session artifacts
dwg_agents_ops/**/__pycache__/
dwg_agents_ops/**/memory/state.json
dwg_agents_ops/**/memory/timeline.jsonl
dwg_agents_ops/**/sessions/session.jsonl
dwg_agents_ops/**/outputs/*.md
dwg_agents_ops/**/**/*.lock
dwg_agents_ops/agent_control/runtime/*.json
dwg_agents_ops/agent_control/*.jsonl
