{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "META_V2 Schema",
  "type": "object",
  "required": [
    "meta_version",
    "meta_scope",
    "script"
  ],
  "properties": {
    "meta_version": {
      "type": "string"
    },
    "meta_scope": {
      "type": "string",
      "enum": [
        "script",
        "functions"
      ]
    },
    "script": {
      "type": "object",
      "required": [
        "name",
        "path",
        "encoding",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "quote": {
      "type": "object"
    },
    "procedure": {
      "type": "object"
    },
    "functions_quote": {
      "type": "object"
    },
    "functions_procedure": {
      "type": "object"
    },
    "functions": {
      "type": "array"
    },
    "dependencies": {
      "type": "object"
    },
    "quality": {
      "type": "object",
      "properties": {
        "todo": {
          "type": "array"
        },
        "function_count": {
          "type": "integer"
        },
        "public_api_count": {
          "type": "integer"
        }
      }
    }
  }
}