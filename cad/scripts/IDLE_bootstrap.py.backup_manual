import sys
import os
import socket
import threading
import time

# 添加脚本目录到 sys.path
SCRIPT_DIR = r'D:/gemini-tasks/cad/scripts'
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

print(f'已将 {SCRIPT_DIR} 加入 sys.path。')
print('等待 Script Navigator 发送运行指令...')

def start_listener():
    """启动 Socket 监听，接收执行脚本的指令"""
    HOST = '127.0.0.1'
    PORT = 65432
    
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        # 允许端口复用，防止重启时报错
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind((HOST, PORT))
            s.listen()
            # print(f"Listening on {HOST}:{PORT}")
        except Exception as e:
            print(f"无法绑定端口 {PORT}: {e}")
            return

        while True:
            try:
                conn, addr = s.accept()
                with conn:
                    data = conn.recv(4096).decode('utf-8').strip()
                    if data.startswith("RUN:"):
                        script_path = data[4:]
                        print(f"\n>>> 正在运行: {script_path}")
                        if os.path.exists(script_path):
                            try:
                                # 读取并执行脚本
                                # 使用 exec 使得变量保留在当前 Shell 的命名空间中
                                with open(script_path, 'r', encoding='utf-8') as f:
                                    code = f.read()
                                
                                # 切换当前工作目录到脚本所在目录
                                script_dir = os.path.dirname(script_path)
                                old_cwd = os.getcwd()
                                try:
                                    os.chdir(script_dir)
                                    # 模拟 __file__
                                    global_vars = globals()
                                    global_vars['__file__'] = script_path
                                    exec(code, global_vars)
                                finally:
                                    os.chdir(old_cwd)
                                    
                                print(f"<<< 运行结束: {script_path}")
                            except Exception as e:
                                print(f"!!! 运行出错: {e}")
                                import traceback
                                traceback.print_exc()
                        else:
                            print(f"!!! 文件不存在: {script_path}")
            except Exception as e:
                print(f"Socket 错误: {e}")

# 启动后台线程
t = threading.Thread(target=start_listener, daemon=True)
t.start()

print("\n" + "="*50)
print(" " * 10 + "CAD Automation Scripts Function Summary")
print("="*50 + "\n")

try:
    summary_path = os.path.join(SCRIPT_DIR, 'CAD_function_summary.md')
    if os.path.exists(summary_path):
        with open(summary_path, 'r', encoding='utf-8') as f:
            print(f.read())
    else:
        print("提示: 未找到 'CAD_function_summary.md' 文件。")
except Exception as e:
    print(f"读取摘要文件时出错: {e}")

print("\n" + "="*50)
print(" " * 18 + "End of Summary")
print("="*50 + "\n")
