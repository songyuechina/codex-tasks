        "returns": "False"
      },
      {
        "case": "doc.SaveAs 或其他代码抛出异常",
        "symptom": "捕获 Exception",
        "handling": "记录错误日志",
        "returns": "False"
      }
    ],
    "side_effects": [
      "调用 CAD 对象 SaveAs，写入文件系统",
