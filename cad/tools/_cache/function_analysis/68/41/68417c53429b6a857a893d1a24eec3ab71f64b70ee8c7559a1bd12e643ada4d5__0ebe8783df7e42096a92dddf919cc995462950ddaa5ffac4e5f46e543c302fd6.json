  "analysis": {
    "function": "close_oldest_cad_process",
    "summary": "查找同名 CAD 进程，若数量超过 1 个则终止最早启动的进程，并记录日志；否则打印提示。",
    "inputs": [
      {
        "name": "process_name",
        "type": "str",
        "meaning": "目标进程名称，用于筛选 CAD 进程",
        "default": "acad.exe"
      }
    ],
    "steps": [
      "遍历系统进程并筛选名称匹配的进程",
      "判断匹配进程数量是否大于 1",
      "若大于 1，按创建时间排序取最早进程并尝试终止",
      "记录成功或异常日志",
      "若不足 2 个，打印提示信息"
    ],
    "branches": [
      {
        "when": "len(cad_processes) > 1 且终止成功",
        "does": "终止最早启动的进程并记录日志",
        "returns": "None"
      },
      {
        "when": "len(cad_processes) > 1 且终止失败抛异常",
        "does": "记录异常日志并忽略异常",
        "returns": "None"
      },
      {
        "when": "len(cad_processes) <= 1",
        "does": "打印没有多个 CAD 进程的提示",
        "returns": "None"
      }
    ],
    "errors": [
      {
        "case": "psutil.Process(...).terminate() 抛出异常（权限不足/进程不存在等）",
        "symptom": "无法终止进程",
        "handling": "捕获异常并记录日志",
        "returns": "None"
      },
      {
        "case": "psutil.process_iter 访问进程信息时异常",
        "symptom": "进程遍历失败",
        "handling": "未显式处理，可能传播异常",
        "returns": "异常传播"
      }
    ],
    "side_effects": [
      "读取系统进程列表（psutil）",
      "终止系统进程",
      "写入日志（sys_logger.info）",
      "向标准输出打印提示"
    ],
