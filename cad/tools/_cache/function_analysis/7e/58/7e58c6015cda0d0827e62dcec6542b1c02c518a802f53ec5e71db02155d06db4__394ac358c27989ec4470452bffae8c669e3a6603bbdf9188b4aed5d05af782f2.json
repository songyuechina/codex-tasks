{
  "analysis": {
    "function": "current_dwg_basename",
    "summary": "从 CAD 当前文档名称中提取不带扩展名的文件名。",
    "inputs": [],
    "steps": [
      "读取 acad.ActiveDocument.Name 获取当前文档名称",
      "对名称先取 basename 再去掉扩展名",
      "返回处理后的基础文件名"
    ],
    "branches": [
      {
        "when": "Name 包含路径或扩展名",
        "does": "basename+splitext 去除路径与扩展",
        "returns": "基础文件名字符串"
      },
      {
        "when": "Name 不包含路径或扩展名",
        "does": "splitext 返回原名",
        "returns": "原名字符串"
      }
    ],
    "errors": [
      {
        "case": "acad 或 ActiveDocument 不可用",
        "symptom": "AttributeError/COMError",
        "handling": "未处理，异常向外抛出",
        "returns": null
      },
      {
        "case": "Name 为 None 或非字符串",
        "symptom": "TypeError in os.path",
        "handling": "未处理，异常向外抛出",
        "returns": null
      }
    ],
    "side_effects": [
      "访问外部 CAD 对象 acad.ActiveDocument.Name（COM/应用状态依赖）"
    ],
    "returns": {
      "shape": "string",
      "fields": [
        {
          "path": "",
          "meaning": "当前文档不带扩展名的文件名",
          "example": "floorplan"
        }
      ]
    },
    "examples": [
      {
        "call": "current_dwg_basename() with Name='C:/proj/floorplan.dwg'",
        "expect": "floorplan"
      },
      {
        "call": "current_dwg_basename() with Name='draft1.dwg'",
        "expect": "draft1"
      },
      {
        "call": "current_dwg_basename() with Name='Untitled'",
        "expect": "Untitled"
      }
    ]
  },
  "contract": {
    "function": "current_dwg_basename",
    "inputs": {
      "required": [],
      "optional": {}
    },
    "outputs": {
      "success": {
        "type": "string",
        "fields": [
          {
