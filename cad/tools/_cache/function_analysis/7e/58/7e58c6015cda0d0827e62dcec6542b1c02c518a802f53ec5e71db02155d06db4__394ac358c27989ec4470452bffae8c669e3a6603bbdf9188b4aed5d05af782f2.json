            "meaning": "当前文档不带扩展名的文件名",
            "example": "floorplan"
          }
        ],
        "meaning": "函数正常执行时的返回结果"
      },
      "failure": [
        {
          "when": "acad 或 ActiveDocument 不可用",
          "returns": null,
          "meaning": "AttributeError/COMError"
        },
        {
          "when": "Name 为 None 或非字符串",
          "returns": null,
          "meaning": "TypeError in os.path"
        }
      ]
    },
    "side_effects": [
      "访问外部 CAD 对象 acad.ActiveDocument.Name（COM/应用状态依赖）"
    ],
    "safe_usage_notes": [
      "返回值为字符串，调用方需通过内容判断成功/失败（例如是否以 ❌ 开头）"
    ]
